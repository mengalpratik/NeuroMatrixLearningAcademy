# NeuroMatrix Learning Academy Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Settings
PROJECT_NAME="NeuroMatrix Learning Academy"
API_V1_STR="/api"
DEFAULT_USER_ID="learner-prime"

# Database Configuration (Async SQLite via aiosqlite)
# Local development:
DATABASE_URL="sqlite+aiosqlite:///./neuromatrix_academy.db"
# Docker container environment:
# DATABASE_URL="sqlite+aiosqlite:////app/data/neuromatrix_academy.db"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Docker Compose Host Port Binding
ACADEMY_HOST_PORT=18080

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000","http://localhost:18080","http://127.0.0.1:18080"]'
